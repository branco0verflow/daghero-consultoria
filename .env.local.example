# Credenciales de EmailJS para el formulario de contacto (components/ContactForm.tsx).
# Copiá este archivo a ".env.local" (que ya está ignorado por git) y completá
# los 3 valores. Instrucciones paso a paso en el README, sección
# "Formulario de contacto (EmailJS)".

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
